{
  "name": "networking-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private networking tracker for staying in touch with the people you meet at Berkeley.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node apps/api/server.js",
    "dev:web": "vite --config apps/web/vite.config.js",
    "build": "vite build --config apps/web/vite.config.js",
    "preview": "vite preview --config apps/web/vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/neon-js": "0.7.0-beta",
    "express": "^5.2.1",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "postcss": "^8.4.49",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
