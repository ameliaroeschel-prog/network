# Copy this file to .env.local and fill in the real values from your Neon Console.
# .env.local is gitignored and must never be committed.
#
# Both URLs are copied from the Neon Console — do not type them from memory.
# The hostnames contain ".neonauth" and ".apirest" labels that are easy to get wrong.
#   Auth URL      Console -> Auth -> Configuration
#   Data API URL  Console -> Postgres database -> Data API


# ---------------------------------------------------------------------------
# Server only — never sent to the browser
# ---------------------------------------------------------------------------
# Neither of these has a VITE_ prefix, so Vite will not bundle them into the
# JavaScript the browser downloads. They are read only by the Express API.

# Used for two things: verifying the signature on incoming tokens (via Neon's
# public JWKS keys), and as the target of the same-origin auth proxy.
NEON_AUTH_BASE_URL=https://ep-example-123.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Where the API sends database queries, carrying the signed-in user's token.
NEON_DATA_API_URL=https://ep-example-123.apirest.us-east-1.aws.neon.tech/neondb/rest/v1

# Port for the local API server. Not needed in production.
PORT=3001


# ---------------------------------------------------------------------------
# Deliberately absent: any client-side variable at all
# ---------------------------------------------------------------------------
# There are no VITE_* variables in this project. The browser talks only to this
# app's own /api routes — for contacts AND for signing in — so it never needs
# the Neon URLs.
#
# Auth goes through /api/auth, which Express forwards to Neon. That keeps the
# session cookie first-party, which is what makes sign-in work in Safari and
# other browsers that block third-party cookies.


# ---------------------------------------------------------------------------
# Deliberately absent: DATABASE_URL
# ---------------------------------------------------------------------------
# This project never uses a Postgres connection string. All database access
# goes through the Neon Data API carrying the signed-in user's token, so Row
# Level Security applies to every query.
#
# Connecting with DATABASE_URL would authenticate as the database owner, which
# BYPASSES Row Level Security entirely. Not having the string anywhere is a
# security win: a credential that does not exist in the repo cannot leak.
